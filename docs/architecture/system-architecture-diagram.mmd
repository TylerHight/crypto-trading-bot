%%{init: {"architecture": {"nodeSeparation": 100, "idealEdgeLengthMultiplier": 2}}}%%
architecture-beta
    group sources(cloud)[Market Data Sources]
        service ws(mdi:webhook)[Public Exchange WebSocket] in sources
        service rest(mdi:api)[Historical REST API] in sources

    group streaming(mdi:chart-sankey)[Portable Streaming Path]
        service collector(logos:python)[Python Collector Container] in streaming
        service kafka(logos:aws-msk)[Kafka Local or Amazon MSK] in streaming
        service streamJob(logos:apache-spark)[PySpark Streaming Local or EMR] in streaming
        service candleTopic(mdi:chart-waterfall)[Kafka Candle Topic] in streaming

    group batch(mdi:history)[Portable Batch and Replay Path]
        service backfill(logos:python)[Python Backfill Container] in batch
        service replayJob(logos:apache-spark)[PySpark Replay Local or EMR] in batch
        service airflow(logos:airflow)[Airflow Local or AWS Container] in batch

    group platform(logos:aws)[Portable AWS Data Platform]
        service raw(logos:aws-s3)[MinIO or S3 Raw Parquet] in platform
        service curated(logos:aws-s3)[MinIO or S3 Curated Parquet] in platform
        service catalog(logos:aws-glue)[Local Schemas or AWS Glue Catalog] in platform
        service query(logos:aws-athena)[DuckDB or Amazon Athena] in platform
        service dbt(logos:dbt-icon)[dbt Build and Test] in platform
        service marts(disk)[Parquet Analytics Marts] in platform

    group products(mdi:view-dashboard)[Data Products]
        service dashboard(mdi:view-dashboard)[Data Quality and Market Dashboard] in products
        service trading(mdi:robot)[Automated Trading Backtest to Live] in products

    %% Streaming ingestion
    ws{group}:B --> T:collector{group}
    collector:R --> L:kafka
    kafka:R --> L:streamJob
    streamJob:R --> L:candleTopic

    %% Streaming outputs
    streamJob{group}:B --> T:raw{group}
    streamJob{group}:B --> T:curated{group}

    %% Batch ingestion and replay
    rest{group}:B --> T:backfill{group}
    backfill{group}:B --> T:raw{group}
    raw{group}:T --> B:replayJob{group}
    replayJob{group}:B --> T:curated{group}

    %% Catalog and analytical transformation
    curated:R --> L:catalog
    catalog:R --> L:query
    query:R --> L:dbt
    dbt:R --> L:marts

    %% Data products and trading feedback
    marts{group}:R --> L:dashboard{group}
    candleTopic{group}:R --> L:trading{group}
    trading{group}:T --> T:kafka{group}

    %% Airflow orchestration
    airflow:L --> R:backfill
    airflow:R --> L:replayJob
    airflow{group}:B --> T:catalog{group}
    airflow{group}:B --> T:dbt{group}

    %% Layout
    align row ws rest
    align row collector kafka streamJob candleTopic trading
    align row backfill airflow replayJob
    align row raw curated catalog query dbt marts dashboard
    align column ws collector
    align column rest backfill
    align column replayJob curated
    align column trading dashboard
