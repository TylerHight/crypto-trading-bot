# Public exchange configuration
COLLECTOR_EXCHANGE=coinbase
COLLECTOR_WEBSOCKET_URL=wss://advanced-trade-ws.coinbase.com
COLLECTOR_SYMBOLS=["BTC-USD","ETH-USD"]

# Local Kafka configuration
COLLECTOR_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
COLLECTOR_KAFKA_TOPIC=market.trades.raw.v1
COLLECTOR_KAFKA_CLIENT_ID=market-data-collector
COLLECTOR_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Retry and shutdown bounds
COLLECTOR_RECONNECT_INITIAL_SECONDS=1
COLLECTOR_RECONNECT_MAX_SECONDS=30
COLLECTOR_KAFKA_POLL_TIMEOUT_SECONDS=0.1
COLLECTOR_KAFKA_FLUSH_TIMEOUT_SECONDS=10

# Bounded Coinbase REST-to-archive reconciliation
RECONCILIATION_RAW_INPUT=s3a://crypto-data/raw/market_trade_raw/v1
RECONCILIATION_REPORT_OUTPUT=s3a://crypto-data/reconciliation/coinbase-trades
RECONCILIATION_S3_ENDPOINT=http://127.0.0.1:9000
RECONCILIATION_S3_ACCESS_KEY=minioadmin
RECONCILIATION_S3_SECRET_KEY=minioadmin
RECONCILIATION_MAXIMUM_WINDOW_SECONDS=900
RECONCILIATION_REST_LIMIT=1000
RECONCILIATION_MAXIMUM_REST_REQUESTS=100
RECONCILIATION_MINIMUM_SPLIT_SECONDS=1
RECONCILIATION_TIMEOUT_SECONDS=10
RECONCILIATION_MAXIMUM_RETRIES=3
RECONCILIATION_MAXIMUM_RETRY_DELAY_SECONDS=30
RECONCILIATION_SAMPLE_LIMIT=20
# COINBASE_API_BEARER_TOKEN=replace-with-a-short-lived-token-when-required

# Dry-run-first confirmed-gap backfill
BACKFILL_FINDINGS_PREFIX=s3a://crypto-data/reconciliation/coinbase-trades/findings
BACKFILL_STATE_OUTPUT=s3a://crypto-data/backfill/coinbase-trades
BACKFILL_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BACKFILL_KAFKA_TOPIC=market.trades.raw.v1
BACKFILL_KAFKA_CLIENT_ID=coinbase-trade-backfill
BACKFILL_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
BACKFILL_KAFKA_ACK_TIMEOUT_SECONDS=10
BACKFILL_KAFKA_QUEUE_FULL_RETRIES=3
BACKFILL_VERIFICATION_TIMEOUT_SECONDS=30
BACKFILL_VERIFICATION_POLL_SECONDS=1
BACKFILL_SAMPLE_LIMIT=20
COLLECTOR_KAFKA_QUEUE_FULL_RETRIES=3
