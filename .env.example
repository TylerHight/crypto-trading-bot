# Public exchange configuration
COLLECTOR_EXCHANGE=coinbase
COLLECTOR_WEBSOCKET_URL=wss://advanced-trade-ws.coinbase.com
COLLECTOR_SYMBOLS=["BTC-USD","ETH-USD"]

# Local Kafka configuration
COLLECTOR_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
COLLECTOR_KAFKA_TOPIC=market.trades.raw.v1
COLLECTOR_KAFKA_CLIENT_ID=market-data-collector
COLLECTOR_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Retry and shutdown bounds
COLLECTOR_RECONNECT_INITIAL_SECONDS=1
COLLECTOR_RECONNECT_MAX_SECONDS=30
COLLECTOR_KAFKA_POLL_TIMEOUT_SECONDS=0.1
COLLECTOR_KAFKA_FLUSH_TIMEOUT_SECONDS=10
COLLECTOR_KAFKA_QUEUE_FULL_RETRIES=3
