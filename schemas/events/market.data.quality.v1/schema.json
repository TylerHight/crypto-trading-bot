{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-trading-bot.local/schemas/market.data.quality.v1.json",
  "title": "Market Data Quality Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "exchange",
    "connection_id",
    "observation_type",
    "detected_at",
    "connection_started_at",
    "affected_symbols",
    "channel",
    "stream",
    "previous_sequence",
    "current_sequence",
    "missing_from",
    "missing_to",
    "last_envelope_sequence",
    "last_heartbeat_counter",
    "seconds_since_last_message",
    "seconds_since_last_heartbeat",
    "envelopes_observed",
    "trades_observed",
    "heartbeats_observed",
    "sequence_gap_count",
    "duplicate_sequence_count",
    "out_of_order_sequence_count",
    "malformed_message_count",
    "reason",
    "message_excerpt",
    "message_sha256",
    "producer",
    "trace_id"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "market.data.quality"},
    "schema_version": {"const": "v1"},
    "exchange": {"type": "string", "minLength": 1},
    "connection_id": {"type": "string", "format": "uuid"},
    "observation_type": {
      "enum": [
        "connection_opened",
        "connection_closed",
        "connection_recovered",
        "reconnect_scheduled",
        "reconnect_attempt",
        "sequence_gap",
        "duplicate_sequence",
        "out_of_order_sequence",
        "heartbeat_gap",
        "heartbeat_silence",
        "malformed_message",
        "health_summary"
      ]
    },
    "detected_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "connection_started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "affected_symbols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "channel": {"type": ["string", "null"]},
    "stream": {"type": ["string", "null"]},
    "previous_sequence": {"type": ["integer", "null"], "minimum": 0},
    "current_sequence": {"type": ["integer", "null"], "minimum": 0},
    "missing_from": {"type": ["integer", "null"], "minimum": 0},
    "missing_to": {"type": ["integer", "null"], "minimum": 0},
    "last_envelope_sequence": {"type": ["integer", "null"], "minimum": 0},
    "last_heartbeat_counter": {"type": ["integer", "null"], "minimum": 0},
    "seconds_since_last_message": {"type": ["number", "null"], "minimum": 0},
    "seconds_since_last_heartbeat": {"type": ["number", "null"], "minimum": 0},
    "envelopes_observed": {"type": "integer", "minimum": 0},
    "trades_observed": {"type": "integer", "minimum": 0},
    "heartbeats_observed": {"type": "integer", "minimum": 0},
    "sequence_gap_count": {"type": "integer", "minimum": 0},
    "duplicate_sequence_count": {"type": "integer", "minimum": 0},
    "out_of_order_sequence_count": {"type": "integer", "minimum": 0},
    "malformed_message_count": {"type": "integer", "minimum": 0},
    "reason": {"type": ["string", "null"], "maxLength": 500},
    "message_excerpt": {"type": ["string", "null"], "maxLength": 1024},
    "message_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer": {"const": "apps.collector"},
    "trace_id": {"type": "string", "format": "uuid"}
  }
}
