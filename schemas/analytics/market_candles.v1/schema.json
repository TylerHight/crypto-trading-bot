{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-trading-bot.local/schemas/market-candles-v1.json",
  "title": "One-minute Market Candles v1",
  "description": "Deterministic event-time OHLCV/VWAP candles derived from one published curated-trade snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exchange", "symbol", "interval", "window_start", "window_end",
    "open", "high", "low", "close", "base_volume", "quote_volume",
    "vwap", "trade_count", "historical_backfill_trade_count",
    "first_event_id", "last_event_id", "minimum_kafka_timestamp",
    "maximum_kafka_timestamp", "minimum_ingested_at", "maximum_ingested_at",
    "source_curated_snapshot_key", "candle_schema_version",
    "candle_transform_version", "created_at", "event_date", "event_hour"
  ],
  "properties": {
    "exchange": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "symbol": {"type": "string", "pattern": "^[A-Z0-9]+-[A-Z0-9]+$"},
    "interval": {"const": "1m"},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "open": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{18}$"},
    "high": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{18}$"},
    "low": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{18}$"},
    "close": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{18}$"},
    "base_volume": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{18}$"},
    "quote_volume": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{18}$"},
    "vwap": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{18}$"},
    "trade_count": {"type": "integer", "minimum": 1},
    "historical_backfill_trade_count": {"type": "integer", "minimum": 0},
    "first_event_id": {"type": "string", "format": "uuid"},
    "last_event_id": {"type": "string", "format": "uuid"},
    "minimum_kafka_timestamp": {"type": "string", "format": "date-time"},
    "maximum_kafka_timestamp": {"type": "string", "format": "date-time"},
    "minimum_ingested_at": {"type": "string", "format": "date-time"},
    "maximum_ingested_at": {"type": "string", "format": "date-time"},
    "source_curated_snapshot_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candle_schema_version": {"const": "v1"},
    "candle_transform_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "event_date": {"type": "string", "format": "date"},
    "event_hour": {"type": "string", "pattern": "^[0-2][0-9]$"}
  },
  "x-parquet-types": {
    "open": "decimal(38,18)",
    "high": "decimal(38,18)",
    "low": "decimal(38,18)",
    "close": "decimal(38,18)",
    "base_volume": "decimal(38,18)",
    "quote_volume": "decimal(38,18)",
    "vwap": "decimal(38,18)"
  }
}
