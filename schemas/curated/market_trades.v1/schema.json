{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-trading-bot.local/schemas/curated-market-trades-v1.json",
  "title": "Curated Market Trades v1",
  "description": "Logical Coinbase trades selected deterministically from immutable raw Kafka deliveries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "exchange",
    "symbol",
    "source_event_id",
    "event_time",
    "ingested_at",
    "kafka_timestamp",
    "price",
    "size",
    "notional",
    "source_side",
    "source_sequence",
    "producer",
    "trace_id",
    "correlation_id",
    "causation_id",
    "kafka_topic",
    "kafka_partition",
    "kafka_offset",
    "curated_schema_version",
    "curated_at",
    "event_date"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "exchange": {"const": "coinbase"},
    "symbol": {"type": "string", "pattern": "^[A-Z0-9]+-[A-Z0-9]+$"},
    "source_event_id": {"type": "string", "minLength": 1},
    "event_time": {"type": "string", "format": "date-time"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "kafka_timestamp": {"type": "string", "format": "date-time"},
    "price": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{18}$"},
    "size": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{18}$"},
    "notional": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{18}$"},
    "source_side": {"enum": ["BUY", "SELL"]},
    "source_sequence": {"type": ["integer", "null"], "minimum": 0},
    "producer": {"enum": ["apps.collector", "apps.historical_backfill"]},
    "trace_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": ["string", "null"], "format": "uuid"},
    "causation_id": {"type": ["string", "null"], "format": "uuid"},
    "kafka_topic": {"const": "market.trades.raw.v1"},
    "kafka_partition": {"type": "integer", "minimum": 0},
    "kafka_offset": {"type": "integer", "minimum": 0},
    "curated_schema_version": {"const": "v1"},
    "curated_at": {"type": "string", "format": "date-time"},
    "event_date": {"type": "string", "format": "date"}
  },
  "x-parquet-types": {
    "price": "decimal(38,18)",
    "size": "decimal(38,18)",
    "notional": "decimal(38,18)",
    "event_time": "timestamp UTC",
    "ingested_at": "timestamp UTC",
    "kafka_timestamp": "timestamp UTC",
    "curated_at": "timestamp UTC",
    "event_date": "date"
  }
}
